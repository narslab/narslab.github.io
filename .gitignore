# Environment files
environment*

_site

vendor
!css/bootstrap/vendor/
# Projects
# projects/<name>/index.md is generated by _scripts/update-and-preprocess.rb from
# each repo's README, and must stay committed: the site is built by GitHub
# Actions, which never runs those scripts. Only the generated page and any
# images it references are tracked -- never a cloned working copy.
# Anchored to the repo root so these never swallow docs/projects/, which is
# built output and has to ship.
/projects/**
!/projects/index.html
!/projects/*/
!/projects/*/**/
!/projects/*/index.md
!/projects/*/**/*.png
!/projects/*/**/*.jpg
!/projects/*/**/*.jpeg
!/projects/*/**/*.gif
!/projects/*/**/*.svg
/projects/*/.git/

# Jekyll build process
.jekyll-cache
.jekyll-metadata
.sass-cache

# Other files
.DS_Store
.ruby-version
.tweet-cache
# Zotero paper sync (_scripts/sync-papers.sh)
_scripts/.env.zotero
_scripts/.venv/
_scripts/.zotero-cache.json
_scripts/__pycache__/
.claude/*.tmp.*
